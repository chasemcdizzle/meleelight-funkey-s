#!/bin/bash
# scratch (gitignored): NEGATIVE TESTS for port/sim/device/check-cite-closure.sh
# (fix_plan C25 / C26 / C27). Modelled on .loop/cite-teeth.sh.
#
# Each tooth perturbs ONE thing and RE-ANCHORS the ledger (LEDGER_SHA256 in the
# checker), because otherwise every tooth would trip the integrity seal first
# and prove nothing about the logic under test — the measured
# "perturbed-frozen-copy trips the seal before the comparator" class. Exactly
# one tooth (T0) deliberately skips the re-anchor, to prove the seal itself.
#
# RC-BLINDNESS (the measured false-green of the last cycle): a nonzero exit
# proves NOTHING on its own. The sound assertion is that the checker's ONLY
# success line — `CITE CLOSURE OK:` — is ABSENT from the output. Every tooth
# asserts that, and separately asserts the specific refusal text.
#
# CONCURRENCY WARNING (inherited from cite-teeth.sh, observed live there): this
# script mutates TRACKED files in place and restores them from an EXIT trap.
# T8 additionally perturbs one producer's bytes. Do not run it concurrently
# with anything that reads the manifest, the ledger or the gate.
set -uo pipefail

S=port/sim/device/check-cite-closure.sh
L=port/sim/device/m4-closure-ledger.txt
PROD=port/goldens-m4/json-dup-key-scan.js       # T8: byte-perturbed, restored

ROW=port/goldens-m4/verify-target-stream.js      # a GO row (cov=sha)
RIG=port/sim/device/riglib.sh                    # a GO row (cov=path)
CAP=port/sim/device/adbsh.sh                     # the CAPPED-CLOSED row
FRZ=oracle/harness/verify-stream.js              # a PROVEN-BY (gate) row
OPEN=port/sim/device/verify_m4.sh                # an arc-in-flight row

cp "$L" /tmp/closure-teeth-ledger.bak
cp "$S" /tmp/closure-teeth-script.bak
cp "$PROD" /tmp/closure-teeth-prod.bak
restore() {
  cp /tmp/closure-teeth-ledger.bak "$L"
  cp /tmp/closure-teeth-script.bak "$S"
  cp /tmp/closure-teeth-prod.bak "$PROD"
}
trap restore EXIT

reanchor() {
  lsha="$(shasum -a 256 "$L" | awk '{print $1}')"
  python3 - "$S" "$lsha" <<'PY'
import sys
s, lsha = sys.argv[1], sys.argv[2]
lines = open(s).read().split('\n')
for i, l in enumerate(lines):
    if l.startswith('LEDGER_SHA256='):
        lines[i] = 'LEDGER_SHA256=' + lsha
open(s, 'w').write('\n'.join(lines))
PY
}

# mut <path> <field-index 2..12> <new value>   (1 == the CLOSURE keyword)
mut() {
  restore
  python3 - "$L" "$1" "$2" "$3" <<'PY'
import sys
led, path, idx, val = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
out, n = [], 0
for l in open(led).read().split('\n'):
    f = l.split(' ')
    if len(f) == 12 and f[0] == 'CLOSURE' and f[1] == path:
        f[idx - 1] = val
        l = ' '.join(f); n += 1
    out.append(l)
assert n == 1, f'expected 1 row for {path}, got {n}'
open(led, 'w').write('\n'.join(out))
PY
  reanchor
}

# raw <python-snippet-on-stdin>   — arbitrary ledger surgery, then re-anchor
raw() { restore; python3 - "$L" ; reanchor; }

fails=0
run() { # run <tooth-name> <expected-refusal-substring>
  out="$(bash "$S" 2>&1)"
  echo "TOOTH: $1"
  if printf '%s' "$out" | grep -qF 'CITE CLOSURE OK:'; then
    echo "  *** FAIL: the checker printed its SUCCESS line — the perturbation"
    echo "      was ACCEPTED (a nonzero rc elsewhere would prove nothing)."
    return 1
  fi
  if printf '%s' "$out" | grep -qF "$2"; then
    printf '%s\n' "$out" | grep -F 'CITE CLOSURE REFUSED' | head -1 | sed 's/^/    /'
    return 0
  fi
  echo "  *** FAIL: expected substring not in refusal: $2"
  printf '%s\n' "$out" | head -3 | sed 's/^/    got: /'
  return 1
}

# --- T0: the integrity seal itself (the ONLY tooth without a re-anchor) ----
restore
printf '# tooth\n' >> "$L"
run "T0 ledger edited without re-anchoring" "do not match the pinned anchor" \
  || fails=$((fails+1))

