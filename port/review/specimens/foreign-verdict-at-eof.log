   181	  Measured over the whole corpus, nothing but a single <TOOL>_RC=<n> marker
   182	  ever follows a terminal verdict. Content after it is the appended-transcript
   183	  shape (fix_plan C26) — a GO that is positionally terminal but inert."
   184	
   185	    # 4d. reviewer identity is DERIVED and compared, never accepted as given.
   186	    evbase="${ev##*/}"
   187	    rcpfx="$(awk -v want="$vline" '
   188	      NR > want { s = $0; sub(/\r$/, "", s)
   189	        if (s ~ /^[A-Z][A-Z0-9]*_RC=[0-9]+$/) { sub(/_RC=.*/, "", s); print s; exit } }' "$ev")"
   190	    case "$rcpfx" in
   191	      CODEX|CODEX3) want_rev=codex ;;
   192	      GROK)         want_rev=grok ;;
   193	      OPUS)         want_rev=opus5 ;;
   194	      '')           case "$evbase" in
   195	                      *grok*) want_rev=grok ;;
   196	                      *opus*) want_rev=opus5 ;;
   197	                      *)      want_rev=codex ;;
   198	                    esac ;;
   199	      *)            refuse "$path: unknown reviewer RC marker '${rcpfx}_RC=' in $ev" ;;
   200	    esac
   201	    [ "$reviewer" = "$want_rev" ] || refuse \
   202	      "$path: reviewer '$reviewer' contradicts the evidence ($ev says '$want_rev')"
   203	
   204	    # 4e. round must actually name this log.
   205	    case "$evbase" in
   206	      *"$round"*) : ;;
   207	      *) refuse "$path: round '$round' does not name the evidence log $evbase" ;;
   208	    esac
   209	    n_go=$((n_go + 1))
   210	  else
   211	    [ "$ev" = "-" ]    || refuse "$path: verdict '$verdict' must carry ev '-', got '$ev'"
   212	    [ "$evsha" = "-" ] || refuse "$path: verdict '$verdict' must carry evsha '-'"
   213	    [ "$vline" = "-" ] || refuse "$path: verdict '$verdict' must carry vline '-'"
   214	  fi
   215	
   216	  # 4f. coverage: what binds this ARC to THIS producer.
   217	  # MEASURED (see the ledger header): the closure round frequently does not
   218	  # name the producer at all — the arc's earlier rounds do. So the binding is
   219	  # a separate, separately sha-pinned artifact, and refusing to model that
   220	  # would false-reject 22 of 59 genuine rows.
   221	  base="${path##*/}"
   222	  case "$cov" in
   223	    sha|path|base)
   224	      case "$covref" in .loop/*) : ;; *) refuse "$path: covref '$covref' is not under .loop/" ;; esac
   225	      if [ -L "$covref" ]; then refuse "$path: covref is a SYMLINK: $covref"; fi
   226	      [ -f "$covref" ] || refuse "$path: covref does not exist: $covref"
   227	      [ -s "$covref" ] || refuse "$path: covref is EMPTY: $covref"
   228	      csha_now="$(sha_of "$covref")"
   229	      [ "$covsha" = "$csha_now" ] || refuse \
   230	        "$path: covref $covref has changed since closure
   231	  pinned:  $covsha
   232	  on disk: $csha_now"
   233	      case "$cov" in
   234	        sha)  needle="$psha" ;;
   235	        path) needle="$path" ;;
   236	        base)
   237	          ndup="$(awk -v b="$base" '$0 ~ /^[0-9a-f]{64} / { n=$2; sub(/^.*\//,"",n); if (n==b) c++ } END { print c+0 }' "$MANIFEST")"
   238	          [ "$ndup" = 1 ] || refuse \
   239	            "$path: cov=base but basename '$base' is not unique among pinned producers ($ndup) — the needle would be vacuous"
   240	          needle="$base" ;;
   241	      esac
   242	      grep -qF -- "$needle" "$covref" || refuse \
   243	        "$path: covref $covref does not contain the $cov needle '$needle'
   244	  The cited arc therefore does not demonstrably cover this producer (C25)." ;;
   245	    ledger)
   246	      [ "$verdict" = CAPPED-CLOSED ] || refuse "$path: cov=ledger requires verdict CAPPED-CLOSED"
   247	      [ "$covsha" = "-" ] || refuse "$path: cov=ledger must carry covsha '-'"
   248	      case "$covref" in
   249	        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
   250	        *) refuse "$path: cov=ledger covref '$covref' is not a YYYY-MM-DD date" ;;
   251	      esac
   252	      ndup="$(awk -v b="$base" '$0 ~ /^[0-9a-f]{64} / { n=$2; sub(/^.*\//,"",n); if (n==b) c++ } END { print c+0 }' "$MANIFEST")"
   253	      [ "$ndup" = 1 ] || refuse \
   254	        "$path: CAPPED-CLOSED binds on basename, but '$base' is not unique ($ndup) — vacuous"
   255	      [ -f "$AGENT_LOG" ] || refuse "$path: cov=ledger but $AGENT_LOG is missing"
   256	      nbind="$(awk -v d="$covref" -v p="$base" '
   257	        /^## / { insec = (index($0, d) > 0) ? 1 : 0 }
   258	        insec && index($0, p) > 0 { n++ }
   259	        END { print n + 0 }' "$AGENT_LOG")"
   260	      [ "$nbind" != 0 ] || refuse \
   261	        "$path: CAPPED-CLOSED names $covref but no '## ... $covref ...' section of
   262	  $AGENT_LOG mentions '$base'. A bare date is not evidence."
   263	      [ "$reviewer" = driver ] || refuse "$path: a driver cap must record reviewer 'driver'"
   264	      n_cap=$((n_cap + 1)) ;;
   265	    gate)
   266	      case "$verdict" in PROVEN-BY-*) : ;; *) refuse "$path: cov=gate requires a PROVEN-BY-* verdict" ;; esac
   267	      [ "$covref" = "-" ] || refuse "$path: cov=gate must carry covref '-'"
   268	      [ "$covsha" = "-" ] || refuse "$path: cov=gate must carry covsha '-'"
   269	      [ "$reviewer" = gate ] || refuse "$path: cov=gate must record reviewer 'gate'"
   270	      n_gate=$((n_gate + 1)) ;;
   271	    *) refuse "$path: unknown coverage kind '$cov'" ;;
   272	  esac
   273	done < "$LEDGER"
   274	
   275	echo "CITE CLOSURE OK: $((n_go + n_cap + n_gate)) records verified ($n_go arc-GO, $n_cap driver-capped, $n_gate gate-proven)"
     1	#!/usr/bin/env python3
     2	"""Derive port/sim/device/m4-closure-ledger.txt from the freeze manifest.
     3	
     4	WHY THIS EXISTS (fix_plan C25/C26/C27). The freeze manifest's `cite` column
     5	is free text. verify_m4.sh's cite check (iter 134) proves a cited log has a
     6	TERMINAL anchored `VERDICT: GO`, which closes the adorned/non-terminal class
     7	— but NOT that the GO is about THAT producer, NOT that the GO is
     8	semantically live rather than pasted, and NOT that a non-arc cite ASSERTS
     9	its gate rather than denying it. This tool migrates the free-text corpus to
    10	a structured closure record that a machine can verify by identity instead of
    11	by prose.
    12	
    13	DERIVATION ONLY — NEVER INVENTION. Every field is read off the existing
    14	corpus (the manifest row, the cited `.loop/` artifacts, docs/AGENT-LOG.md).
    15	A row whose fields cannot ALL be derived is NOT emitted: it is printed under
    16	`CANNOT DERIVE` for a driver ruling. Guessing here would launder exactly the
    17	approval this item exists to stop laundering.
    18	
    19	Usage:
    20	  python3 port/sim/device/gen-closure-ledger.py            # report only
    21	  python3 port/sim/device/gen-closure-ledger.py --write    # write the ledger
    22	"""
    23	import hashlib
    24	import os
    25	import re
    26	import subprocess
    27	import sys
    28	
    29	MANIFEST = "port/sim/device/m4-freeze-manifest.txt"
    30	LEDGER = "port/sim/device/m4-closure-ledger.txt"
    31	AGENT_LOG = "docs/AGENT-LOG.md"
    32	
    33	# Manifest record grammar, anchored exactly as verify_m4.sh parses it.
    34	ROW = re.compile(r"^([0-9a-f]{64}) (\S+) (\S+) (\S+)$")
    35	# Cite artifact grammar, ported verbatim from verify_m4.sh cite_refs().
    36	REF = re.compile(r"\.loop/[A-Za-z0-9._{},-]+\.(?:log|txt)")
    37	# MEASURED over all 21 cited terminal-GO logs (2026-07-29): the only thing
    38	# that ever follows a terminal GO is a single reviewer exit-code marker.
    39	RC_MARK = re.compile(r"^[A-Z][A-Z0-9]*_RC=[0-9]+$")
    40	
    41	CLOSED_ARC = ("reviewed-go",)
    42	CLOSED_GATE = {
    43	    "oracle-frozen": ("PROVEN-BY-HARD-RULE-3", "PROVEN-BY-M0-EXIT-GATE"),
    44	    "grandfathered-m1": ("PROVEN-BY-M1-EXIT-GATE",),
    45	    "grandfathered-m2": ("PROVEN-BY-M2-EXIT-GATE",),
    46	}
    47	OPEN = ("arc-in-flight", "arc-pending")
    48	
    49	# RC-marker prefix -> reviewer identity (PROCESS §4 identity pins, §11 roster).
    50	RC_REVIEWER = {"CODEX": "codex", "CODEX3": "codex", "GROK": "grok",
    51	               "OPUS": "opus5"}
    52	
    53	
    54	def sha256(path):
    55	    h = hashlib.sha256()
    56	    with open(path, "rb") as f:
    57	        for chunk in iter(lambda: f.read(1 << 20), b""):
    58	            h.update(chunk)
    59	    return h.hexdigest()
    60	
    61	
    62	def manifest_rows():
    63	    rows = []
    64	    with open(MANIFEST, encoding="utf-8", errors="replace") as f:
    65	        for line in f.read().split("\n"):
    66	            m = ROW.match(line)
    67	            if m:
    68	                rows.append(m.groups())
    69	    return rows
    70	
    71	
    72	def cite_refs(cite):
    73	    """Boundary-anchored artifact extraction — verify_m4.sh cite_refs()."""
    74	    out, s = [], cite
    75	    while True:
    76	        m = REF.search(s)
    77	        if not m:
    78	            break
    79	        ref, rest = m.group(0), s[m.end():]
    80	        if rest[:1] in ("", "+", "-"):
    81	            out.append(ref)
    82	        s = rest
    83	    return out
    84	
    85	
    86	def cite_expand(ref):
    87	    if "{" in ref and "}" in ref:
    88	        pre, rest = ref.split("{", 1)
    89	        alts, post = rest.split("}", 1)
    90	        return [pre + a + post for a in alts.split(",")]
    91	    return [ref]
    92	
    93	
    94	def log_verdicts(path):
    95	    """-> (lines, [(lineno, 'GO'|'NO-GO'), ...]) with CR stripped."""
    96	    lines = [x.rstrip(b"\r") for x in open(path, "rb").read().split(b"\n")]
    97	    vs = []
    98	    for i, s in enumerate(lines, 1):
    99	        if s == b"VERDICT: GO":
   100	            vs.append((i, "GO"))
   101	        elif s == b"VERDICT: NO-GO":
   102	            vs.append((i, "NO-GO"))
   103	    return lines, vs
   104	
   105	
   106	def tail_ok(lines, vline):
   107	    """MEASURED C26 rule: nothing but blanks and one reviewer RC marker may
   108	    follow the terminal GO. Kills the pasted-transcript and fenced-GO shapes
   109	    that no anchored scan can see. Zero false rejections over the corpus."""
   110	    for s in lines[vline:]:
   111	        t = s.strip()
   112	        if t and not RC_MARK.match(t.decode("utf-8", "replace")):
   113	            return False
   114	    return True
   115	
   116	
   117	def rc_reviewer(lines, vline):
   118	    for s in lines[vline:]:
   119	        t = s.strip().decode("utf-8", "replace")
   120	        if RC_MARK.match(t):
   121	            return RC_REVIEWER.get(t.split("_RC=")[0], "")
   122	    return ""
   123	
   124	
   125	def contains(path, needle):
   126	    return subprocess.call(["grep", "-qF", "--", needle, path],
   127	                           stdout=subprocess.DEVNULL,
   128	                           stderr=subprocess.DEVNULL) == 0
   129	
   130	
   131	def agent_log_bind(date, base):
   132	    """The existing CAPPED arm: a `## ... <date> ...` section mentioning the
   133	    producer basename. Reproduced, not extended."""
   134	    if not os.path.isfile(AGENT_LOG):
   135	        return 0
   136	    n, insec = 0, False
   137	    with open(AGENT_LOG, encoding="utf-8", errors="replace") as f:
   138	        for line in f:
   139	            if line.startswith("## "):
   140	                insec = date in line
   141	            if insec and base in line:
   142	                n += 1
   143	    return n
   144	
   145	
   146	def main():
   147	    rows = manifest_rows()
   148	    bases = [p.rsplit("/", 1)[-1] for _, p, _, _ in rows]
   149	    records, residue, skipped = [], [], []
   150	
   151	    for psha, path, status, cite in rows:
   152	        base = path.rsplit("/", 1)[-1]
   153	        if status in OPEN:
   154	            skipped.append((path, status))
   155	            continue
   156	
   157	        # ---- non-arc rows: a NAMED EXIT GATE, as a positive token (C27) ----
   158	        if status in CLOSED_GATE:
   159	            allowed = CLOSED_GATE[status]
   160	            # Pick the most specific gate the cite already names; the cite is
   161	            # read as a token source only, never as the binding claim.
   162	            # Case-insensitive: the live corpus writes `M2-exit-gate` but
   163	            # `M1-EXIT-GATE` — measured, not assumed.
   164	            tok = ""
   165	            for cand in reversed(allowed):
   166	                if cand[len("PROVEN-BY-"):].lower() in cite.lower():
   167	                    tok = cand
   168	                    break
   169	            if not tok:
   170	                residue.append((path, status,
   171	                                "cite names none of %s" % (allowed,)))
   172	                continue
   173	            records.append([path, psha, tok, "-", "-", "-",
   174	                            "gate", "-", "-", "gate", "-"])
   175	            continue
   176	
   177	        if status not in CLOSED_ARC:
   178	            residue.append((path, status, "unknown status token"))
   179	            continue
   180	
   181	        # ---- reviewed-go: resolve the arc's artifacts ----------------------
   182	        refs = [p for r in cite_refs(cite) for p in cite_expand(r)]
   183	        missing = [p for p in refs if not os.path.isfile(p)]
   184	        if missing:
   185	            residue.append((path, status, "cited artifact absent: %s" % missing[0]))
   186	            continue
   187	
   188	        golog = []
   189	        for p in refs:
   190	            if not p.endswith(".log"):
   191	                continue
   192	            lines, vs = log_verdicts(p)
   193	            if vs and vs[-1][1] == "GO":
   194	                golog.append((p, lines, vs[-1][0]))
   195	
   196	        # ---- coverage: which artifact of THIS arc proves it covered THIS
   197	        # producer? Strongest first. MEASURED priority (see the lane report):
   198	        # the arc's EARLY rounds name the producer, the closure round often
   199	        # does not, so coverage is an ARC-level relation, not a log-level one.
   200	        cov, covref = "", ""
   201	        for kind, needle in (("sha", psha), ("path", path), ("base", base)):
   202	            if kind == "base" and bases.count(base) != 1:
   203	                continue  # non-unique basename => vacuous needle, refuse it
   204	            for p in refs:
   205	                if contains(p, needle):
   206	                    cov, covref = kind, p
   207	                    break
   208	            if cov:
   209	                break
   210	
   211	        if golog:
   212	            evp, evlines, evline = golog[-1]
   213	            if not tail_ok(evlines, evline):
   214	                residue.append((path, status,
   215	                                "terminal GO in %s is followed by non-RC content"
   216	                                % evp))
   217	                continue
   218	            rev = rc_reviewer(evlines, evline)
   219	            if not rev:
   220	                evbase = evp.rsplit("/", 1)[-1]
   221	                rev = ("grok" if "grok" in evbase else
   222	                       "opus5" if "opus" in evbase else "codex")
   223	            rnd = evp.rsplit("/", 1)[-1][:-len(".log")]
   224	            if rnd.startswith("review-"):
   225	                rnd = rnd[len("review-"):]
   226	            if not cov:
   227	                residue.append((path, status,
   228	                                "no cited artifact names the producer "
   229	                                "(path/basename/sha) — arc coverage unprovable"))
   230	                continue
   231	            records.append([path, psha, "GO", evp, sha256(evp), str(evline),
   232	                            cov, covref, sha256(covref), rev, rnd])
   233	            continue
   234	
   235	        # ---- driver cap ---------------------------------------------------
   236	        if "CAPPED-CLOSED" in cite:
   237	            m = re.search(r"AGENT-LOG-([0-9]{4}-[0-9]{2}-[0-9]{2})", cite)
   238	            if not m:
   239	                residue.append((path, status, "CAPPED-CLOSED without a date"))
   240	                continue
   241	            if bases.count(base) != 1:
   242	                residue.append((path, status,
   243	                                "CAPPED-CLOSED but basename not unique"))
   244	                continue
   245	            if agent_log_bind(m.group(1), base) == 0:
   246	                residue.append((path, status,
   247	                                "CAPPED-CLOSED date %s binds no ledger section"
   248	                                % m.group(1)))
   249	                continue
   250	            records.append([path, psha, "CAPPED-CLOSED", "-", "-", "-",
   251	                            "ledger", m.group(1), "-", "driver", "-"])
   252	            continue
   253	
   254	        residue.append((path, status, "no terminal-GO log and no driver cap"))
   255	
   256	    records.sort(key=lambda r: r[0])
   257	    body = []
   258	    for r in records:
   259	        body.append("CLOSURE " + " ".join(r))
   260	
   261	    print("== derived closure records ==")
   262	    print("  manifest rows      : %d" % len(rows))
   263	    print("  emitted records    : %d" % len(records))
   264	    print("  open (no record)   : %d" % len(skipped))
   265	    print("  CANNOT DERIVE      : %d" % len(residue))
   266	    by = {}
   267	    for r in records:
   268	        by[r[2] if r[2] != "GO" else "GO/" + r[6]] = \
   269	            by.get(r[2] if r[2] != "GO" else "GO/" + r[6], 0) + 1
   270	    for k in sorted(by):
   271	        print("      %-28s %d" % (k, by[k]))
   272	    if residue:
   273	        print("\n== CANNOT DERIVE (driver ruling required) ==")
   274	        for p, s, why in residue:
   275	            print("  %-56s %-14s %s" % (p, s, why))
   276	    if skipped:
   277	        print("\n== open rows, deliberately unrecorded ==")
   278	        for p, s in skipped:
   279	            print("  %-56s %s" % (p, s))
   280	
   281	    if "--write" in sys.argv:
   282	        if residue:
   283	            print("\nREFUSING to write: %d row(s) cannot be derived. A partial "
   284	                  "ledger would be a silent coverage gap." % len(residue))
   285	            return 1
   286	        head = HEADER % (len(records), len(skipped))
   287	        with open(LEDGER, "w", encoding="utf-8") as f:
   288	            f.write(head + "\n".join(body) + "\n")
   289	        print("\nwrote %s (%d records)" % (LEDGER, len(records)))
   290	        print("LEDGER_SHA256=%s" % sha256(LEDGER))
   291	    return 0
   292	
   293	
   294	HEADER = """\
   295	# port/sim/device/m4-closure-ledger.txt — structured closure records for the
   296	# M4 freeze manifest (fix_plan C25/C26/C27). DERIVED, never hand-written:
   297	#   python3 port/sim/device/gen-closure-ledger.py --write
   298	# Verified by: bash port/sim/device/check-cite-closure.sh -> CITE CLOSURE OK
   299	#
   300	# WHY. The manifest's `cite` column is free text, so a `reviewed-go` row can
   301	# cite a real terminal GO that belongs to a DIFFERENT arc (C25), a GO that is
   302	# positionally terminal but semantically inert (C26), or, for a non-arc row,
   303	# prose that DENIES the gate it must assert (C27). Nothing in prose binds a
   304	# verdict to a producer. These records do, by identity.
   305	#
   306	# RECORD GRAMMAR — anchored, fixed arity, fail closed. Exactly 12
   307	# whitespace-separated fields; any `CLOSURE` line with a different arity is a
   308	# refusal, never a partial parse (PROCESS §3 whitelist-grammar rule):
   309	#
   310	#   CLOSURE <path> <psha> <verdict> <ev> <evsha> <vline> <cov> <covref> <covsha> <reviewer> <round>
   311	#
   312	#   path     producer path; must be a manifest row, exactly once
   313	#   psha     producer sha256; must equal the manifest row AND the bytes on disk
   314	#   verdict  GO | CAPPED-CLOSED | PROVEN-BY-HARD-RULE-3 | PROVEN-BY-M0-EXIT-GATE
   315	#            | PROVEN-BY-M1-EXIT-GATE | PROVEN-BY-M2-EXIT-GATE
   316	#            Closed vocabulary matched WHOLE-FIELD, so C27's denial hole
   317	#            ("...NOT-proven-by-SIM-CONFORMS...") is unrepresentable.
   318	#   ev       the closure log carrying the verdict (`-` when not arc-closed)
   319	#   evsha    sha256 of that log — evidence is now tamper-evident: appending a
   320	#            transcript to a cited log changes this and the gate refuses
   321	#   vline    1-based line number of the verdict INSIDE ev. The gate reads THAT
   322	#            line, requires it to be exactly `VERDICT: GO`, requires it to be
   323	#            the LAST anchored verdict in the file, and requires everything
   324	#            after it to be blank or a single reviewer RC marker (C26).
   325	#   cov      how the arc is bound to THIS producer: sha | path | base |
   326	#            ledger | gate
   327	#   covref   the artifact (or AGENT-LOG date) carrying that binding
   328	#   covsha   sha256 of covref (`-` for ledger/gate)
   329	#   reviewer codex | grok | opus5 | driver | gate  (PROCESS §4/§11 identity)
   330	#   round    the arc round; must be a substring of ev's basename
   331	#
   332	# COVERAGE IS AN ARC-LEVEL RELATION, MEASURED NOT ASSUMED. Over the live
   333	# corpus the arc's EARLY rounds name the producer and the closure round often
   334	# does not (measured: only 37 of 59 GO-backed rows have a terminal-GO log
   335	# naming their own path; the naive "the GO log must name the producer" rule
   336	# false-rejects 22 real rows). So `ev` supplies the VERDICT and `covref`
   337	# supplies the BINDING, and both are sha-pinned. That is what the evidence
   338	# actually supports.
   339	#
   340	# %d records; %d manifest rows are deliberately UNRECORDED because their
   341	# status is arc-in-flight/arc-pending — an open row must have no closure
   342	# record, and the checker refuses one that does.
   343	#
   344	# INTEGRITY ANCHOR: this file's sha256 is pinned as LEDGER_SHA256= inside
   345	# port/sim/device/check-cite-closure.sh. ANY edit here — record or comment —
   346	# must update that literal IN THE SAME COMMIT:
   347	#   shasum -a 256 port/sim/device/m4-closure-ledger.txt
   348	# Regenerating (`--write`) prints the new value.
   349	#
   350	"""
   351	
   352	if __name__ == "__main__":
   353	    sys.exit(main())
     1	#!/bin/bash
     2	# scratch (gitignored): NEGATIVE TESTS for port/sim/device/check-cite-closure.sh
     3	# (fix_plan C25 / C26 / C27). Modelled on .loop/cite-teeth.sh.
     4	#
     5	# Each tooth perturbs ONE thing and RE-ANCHORS the ledger (LEDGER_SHA256 in the
