+// ---------------------------------------------------------------------------
+// Determinism-spike harness hooks (spikes/determinism in meleelight-funkey-s).
+// Only active when the driving page sets window.__harnessMode before start().
+/* eslint-disable */
+export function harnessSetupMatch (cfg){
+  for (var i = 0; i < 4; i++) {
+    var pc = cfg.players[i];
+    if (pc) {
+      playerType[i] = pc.type;                 // 0 = human, 1 = cpu
+      mType[i] = "keyboard";
+      currentPlayers[i] = i;
+      characterSelections[i] = pc.character;   // 0 marth 1 puff 2 fox 3 falco 4 falcon
+      cpuDifficulty[i] = (pc.difficulty === undefined) ? 3 : pc.difficulty;
+    } else {
+      playerType[i] = -1;
+      currentPlayers[i] = -1;
+    }
+  }
+  setStageSelect(cfg.stage === undefined ? 0 : cfg.stage);
+  startGame();
+}
+
+if (typeof window !== "undefined") {
+  window.__harness = {
+    setupMatch: harnessSetupMatch,
+    gameTick: gameTick,
+    step: function (){ gameTick(window.__nextInputBuffers); },
+    getPlayers: function (){ return player; },
+    getPlayerType: function (){ return playerType; },
+    getArticles: function (){ return require("physics/article").aArticles; },
+    getGameMode: function (){ return gameMode; },
+    isStarting: function (){ return starting; },
+    isPlaying: function (){ return playing; },
+    getMatchTimer: function (){ return matchTimer; }
+  };
+}
